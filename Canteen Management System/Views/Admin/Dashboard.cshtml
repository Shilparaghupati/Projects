@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>

    /* ============================= */
    /* DASHBOARD BACKGROUND */
    /* ============================= */

    .admin-dashboard-page {
        min-height: calc(100vh - 120px);

        padding: 50px 20px;

        background-image:
            linear-gradient(
                rgba(0, 0, 0, 0.55),
                rgba(0, 0, 0, 0.55)
            ),
            url('/images/admin-dashboard.jpg');

        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }


    /* ============================= */
    /* HEADER */
    /* ============================= */

    .dashboard-header {
        text-align: center;
        color: white;
        margin-bottom: 45px;
    }

    .dashboard-header h1 {
        font-size: 42px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .dashboard-header h4 {
        color: white !important;
        font-size: 21px;
        margin-bottom: 8px;
    }

    .dashboard-header p {
        color: rgba(255,255,255,0.85) !important;
        font-size: 16px;
    }


    /* ============================= */
    /* DASHBOARD CARDS */
    /* ============================= */

    .dashboard-card {
        height: 100%;

        background: rgba(255,255,255,0.96);

        border-radius: 20px;

        border: none;

        overflow: hidden;

        box-shadow:
            0 12px 35px rgba(0,0,0,0.30);

        transition: 0.3s;
    }


    .dashboard-card:hover {
        transform: translateY(-8px);

        box-shadow:
            0 20px 45px rgba(0,0,0,0.40);
    }


    .dashboard-card-body {
        text-align: center;

        padding: 40px 35px;
    }


    /* ============================= */
    /* ICONS */
    /* ============================= */

    .dashboard-icon {
        width: 90px;
        height: 90px;

        margin: 0 auto 20px;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 45px;

        background: #fff1df;
    }


    .orders-icon {
        background: #e7f5ec;
    }


    /* ============================= */
    /* CARD TEXT */
    /* ============================= */

    .dashboard-card h3 {
        color: #333;

        font-size: 26px;

        font-weight: 700;

        margin-bottom: 12px;
    }


    .dashboard-card p {
        color: #777;

        min-height: 48px;

        line-height: 1.6;

        margin-bottom: 25px;
    }


    /* ============================= */
    /* BUTTONS */
    /* ============================= */

    .dashboard-btn {
        width: 100%;

        padding: 13px;

        border: none;

        border-radius: 9px;

        color: white;

        font-size: 16px;

        font-weight: 600;

        text-decoration: none;

        display: block;

        transition: 0.3s;
    }


    .menu-btn {
        background: linear-gradient(
            135deg,
            #ff7a00,
            #ff4d00
        );
    }


    .orders-btn {
        background: linear-gradient(
            135deg,
            #198754,
            #157347
        );
    }


    .dashboard-btn:hover {
        color: white;

        transform: translateY(-2px);

        box-shadow:
            0 7px 18px rgba(0,0,0,0.20);
    }


    /* ============================= */
    /* BOTTOM BUTTONS */
    /* ============================= */

    .dashboard-bottom {
        text-align: center;

        margin-top: 40px;
    }


    .bottom-btn {
        display: inline-block;

        padding: 11px 25px;

        margin: 5px;

        border-radius: 8px;

        text-decoration: none;

        font-weight: 600;

        transition: 0.3s;
    }


    .back-btn {
        background: white;

        color: #444;
    }


    .logout-btn {
        background: #dc3545;

        color: white;
    }


    .bottom-btn:hover {
        transform: translateY(-2px);

        color: inherit;
    }


    .logout-btn:hover {
        color: white;
        background: #bb2d3b;
    }


    /* ============================= */
    /* MOBILE */
    /* ============================= */

    @@media (max-width: 768px) {

        .admin-dashboard-page {
            padding: 35px 15px;
        }

        .dashboard-header h1 {
            font-size: 32px;
        }

        .dashboard-header h4 {
            font-size: 18px;
        }

        .dashboard-card-body {
            padding: 30px 25px;
        }

    }

</style>


<div class="admin-dashboard-page">

    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->

    <div class="dashboard-header">

        <h1>
            👨‍💼 Admin Dashboard
        </h1>

        <h4>
            Welcome, @(ViewBag.AdminName ?? "Canteen Admin")
        </h4>

        <p>
            Manage the canteen system
        </p>

    </div>


    <!-- ============================= -->
    <!-- DASHBOARD OPTIONS -->
    <!-- ============================= -->

    <div class="container">

        <div class="row justify-content-center g-4">


            <!-- ============================= -->
            <!-- MANAGE MENU -->
            <!-- ============================= -->

            <div class="col-md-5">

                <div class="dashboard-card">

                    <div class="dashboard-card-body">

                        <div class="dashboard-icon">
                            🍴
                        </div>

                        <h3>
                            Manage Menu
                        </h3>

                        <p>
                            Add, edit, delete and view food items.
                        </p>

                        <a asp-controller="Admin"
                           asp-action="ManageMenu"
                           class="dashboard-btn menu-btn">

                            🍴 Manage Menu

                        </a>

                    </div>

                </div>

            </div>


            <!-- ============================= -->
            <!-- CUSTOMER ORDERS -->
            <!-- ============================= -->

            <div class="col-md-5">

                <div class="dashboard-card">

                    <div class="dashboard-card-body">

                        <div class="dashboard-icon orders-icon">
                            📦
                        </div>

                        <h3>
                            Customer Orders
                        </h3>

                        <p>
                            View customer orders and update
                            delivery status.
                        </p>

                        <a asp-controller="Admin"
                           asp-action="Orders"
                           class="dashboard-btn orders-btn">

                            📦 View All Orders

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================= -->
        <!-- BOTTOM BUTTONS -->
        <!-- ============================= -->

        <div class="dashboard-bottom">

            <a asp-controller="Home"
               asp-action="Index"
               class="bottom-btn back-btn">

                ← Back

            </a>


            <a asp-controller="Admin"
               asp-action="Logout"
               class="bottom-btn logout-btn">

                🚪 Logout

            </a>

        </div>

    </div>

</div>