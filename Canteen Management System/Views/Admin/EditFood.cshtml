@model CanteenWeb.Models.FoodItem

@{
    ViewData["Title"] = "Edit Food";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-body">

                    <h2>
                        ✏️ Edit Food Item
                    </h2>

                    <form asp-controller="Admin"
                          asp-action="EditFood"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="FoodId" />

                        <div class="mb-3">

                            <label class="form-label">
                                Food Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Category
                            </label>

                            <input asp-for="Category"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control">
                            </textarea>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Price
                            </label>

                            <input asp-for="Price"
                                   type="number"
                                   step="0.01"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Image URL
                            </label>

                            <input asp-for="ImageUrl"
                                   class="form-control" />

                        </div>

                        <div class="form-check mb-4">

                            <input asp-for="IsAvailable"
                                   class="form-check-input" />

                            <label class="form-check-label">
                                Available
                            </label>

                        </div>

                        <button type="submit"
                                class="btn btn-success">

                            Save Changes

                        </button>

                        <a asp-controller="Admin"
                           asp-action="ManageMenu"
                           class="btn btn-secondary">

                            ← Back

                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>