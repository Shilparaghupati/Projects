@{
    ViewData["Title"] = "Admin Login";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Admin Login</title>

    <style>


        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;

            background-image:
                linear-gradient(
                    rgba(0, 0, 0, 0.55),
                    rgba(0, 0, 0, 0.55)
                ),
                url('/images/admin-login.jpg');

            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;

            min-height: 100vh;
        }

        .admin-login-page {
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 40px 20px;
        }

        .admin-login-card {
            width: 420px;
            max-width: 100%;

            background: rgba(255, 255, 255, 0.97);

            padding: 40px;

            border-radius: 20px;

            box-shadow:
                0 15px 45px rgba(0, 0, 0, 0.35);
        }

        .admin-icon {
            width: 70px;
            height: 70px;

            margin: 0 auto 15px;

            border-radius: 50%;

            background: #fff1df;

            display: flex;
            justify-content: center;
            align-items: center;

            font-size: 34px;
        }

        h1 {
            text-align: center;

            color: #333;

            margin: 0 0 8px;

            font-size: 32px;
        }

        .admin-subtitle {
            text-align: center;

            color: #777;

            margin-bottom: 30px;

            font-size: 15px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;

            margin-bottom: 8px;

            font-weight: bold;

            color: #333;
        }

        input {
            width: 100%;

            height: 50px;

            padding: 12px 15px;

            border: 1px solid #ccc;

            border-radius: 9px;

            font-size: 15px;

            outline: none;

            transition: 0.3s;
        }

        input:focus {
            border-color: #ff7200;

            box-shadow:
                0 0 0 3px rgba(255, 114, 0, 0.15);
        }

        .admin-login-btn {
            width: 100%;

            height: 52px;

            margin-top: 5px;

            background: linear-gradient(
                135deg,
                #ff7a00,
                #e85d00
            );

            color: white;

            border: none;

            border-radius: 9px;

            font-size: 17px;

            font-weight: bold;

            cursor: pointer;

            transition: 0.3s;
        }

        .admin-login-btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 8px 18px rgba(232, 93, 0, 0.35);
        }

        .error {
            color: #dc3545;

            background: #ffe5e5;

            padding: 10px;

            border-radius: 7px;

            text-align: center;

            margin-bottom: 18px;

            font-size: 14px;
        }

        .back-home {
            text-align: center;

            margin-top: 25px;
        }

        .back-home a {
            color: #555;

            text-decoration: none;

            font-size: 14px;
        }

        .back-home a:hover {
            color: #ff6500;
        }

        .password-wrapper {
    position: relative;
    width: 100%;
}

.password-wrapper input {
    padding-right: 50px;
}

.password-eye {
    position: absolute;

    right: 12px;
    top: 50%;

    transform: translateY(-50%);

    border: none;
    background: transparent;

    font-size: 20px;

    cursor: pointer;

    padding: 5px;

    color: #666;
}

.password-eye:hover {
    color: #ff6500;
}


        .admin-footer {
            text-align: center;

            margin-top: 18px;

            color: #999;

            font-size: 13px;
        }

        @@media (max-width: 600px) {

            .admin-login-page {
                padding: 25px 15px;
            }

            .admin-login-card {
                padding: 30px 25px;
            }

            h1 {
                font-size: 28px;
            }
        }

      .password-eye {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);

    border: none;
    background: transparent;

    font-size: 20px;
    cursor: pointer;
    padding: 5px;

    color: #666;
    z-index: 5;
}
        
        /* Hide browser's built-in password reveal button */
input[type="password"]::-ms-reveal,
input[type="password"]::-ms-clear {
    display: none;
}

input[type="password"]::-webkit-credentials-auto-fill-button {
    display: none !important;
}


    </style>

</head>

<body>

    <div class="admin-login-page">

        <div class="admin-login-card">

            <div class="admin-icon">
                🔐
            </div>

            <h1>
                Admin Login
            </h1>

            <p class="admin-subtitle">
                Login to manage the canteen system
            </p>


            @if (ViewBag.Error != null)
            {
                <div class="error">
                    @ViewBag.Error
                </div>
            }


            <form asp-controller="Admin"
                  asp-action="Login"
                  method="post">

                <div class="form-group">

                    <label for="email">
                        Email
                    </label>

                    <input type="email"
                           id="email"
                           name="email"
                           placeholder="Enter admin email"
                           required />

                </div>


       <div class="form-group">

    <label for="password">
        Password
    </label>

    <div class="password-wrapper">

        <input type="password"
               id="password"
               name="password"
               placeholder="Enter admin password"
               required />

        <button type="button"
                class="password-eye"
                onclick="togglePassword()"
                aria-label="Show or hide password">
            👁️
        </button>

    </div>

</div>

                <button type="submit"
                        class="admin-login-btn">

                    🔐 Admin Login

                </button>

            </form>


            <div class="back-home">

                <a href="/Home/Index">
                    ← Back to Home
                </a>

            </div>


            <div class="admin-footer">

                🍴 Canteen Management System

            </div>

        </div>

    </div>
<script>
    function togglePassword() {

        const password = document.getElementById("password");
        const eye = document.querySelector(".password-eye");

        if (password.type === "password") {

            password.type = "text";
            eye.textContent = "🙈";

        } else {

            password.type = "password";
            eye.textContent = "👁️";

        }
    }

    
</script>
    

</body>
</html>