@model List<CanteenWeb.Models.FoodItem>

@{
    ViewData["Title"] = "Manage Menu";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>🍴 Manage Menu</h1>

        <a asp-controller="Admin"
           asp-action="AddFood"
           class="btn btn-primary">

            + Add Food

        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning text-center">

            No food items available.

        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">

            <thead class="table-dark">

                <tr>

                    <th>ID</th>

                    <th>Name</th>

                    <th>Category</th>

                    <th>Price</th>

                    <th>Available</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var food in Model)
                {
                    <tr>

                        <td>
                            @food.FoodId
                        </td>

                        <td>
                            @food.Name
                        </td>

                        <td>
                            @food.Category
                        </td>

                        <td>
                            ₹@food.Price.ToString("0.00")
                        </td>

                        <td>

                            @if (food.IsAvailable)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Not Available
                                </span>
                            }

                        </td>

                        <td>

                            <a asp-controller="Admin"
                               asp-action="EditFood"
                               asp-route-id="@food.FoodId"
                               class="btn btn-warning btn-sm">

                                Edit

                            </a>


                            <form asp-controller="Admin"
                                  asp-action="DeleteFood"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@food.FoodId" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Delete this food item?');">

                                    Delete

                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }


    <div class="mt-4">

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-secondary">

            ← Back to Dashboard

        </a>

    </div>

</div>