@model List<CanteenWeb.Models.Order>

@{
    ViewData["Title"] = "Customer Orders";
}

<div class="container mt-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>📦 Customer Orders</h1>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-secondary">

            ← Back to Dashboard

        </a>

    </div>


    <!-- SUCCESS MESSAGE -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- ERROR MESSAGE -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- NO ORDERS -->

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info text-center">

            📦 No customer orders found.

        </div>
    }
    else
    {
        <!-- ORDERS -->

        @foreach (var order in Model)
        {
            <div class="card shadow mb-4">

                <div class="card-body">

                    <div class="row g-4">


                        <!-- CUSTOMER DETAILS -->

                        <div class="col-md-3">

                            <h5>
                                📦 Order #@order.OrderId
                            </h5>

                            <hr />

                            <p>
                                <strong>Customer:</strong><br />

                                @(order.Customer?.Name ?? "Unknown")
                            </p>

                            <p>
                                <strong>Email:</strong><br />

                                @(order.Customer?.Email ?? "Unknown")
                            </p>

                            <p>
                                <strong>Order Date:</strong><br />

                                @order.OrderDate.ToLocalTime()
                            </p>

                        </div>


                        <!-- ORDER ITEMS -->

                        <div class="col-md-4">

                            <h5>
                                🍴 Items
                            </h5>

                            <hr />

                            @if (order.OrderItems != null &&
                                 order.OrderItems.Count > 0)
                            {
                                @foreach (var item in order.OrderItems)
                                {
                                    <div class="mb-2">

                                        <strong>
                                            @(item.FoodItem?.Name ?? "Food")
                                        </strong>

                                        × @item.Quantity

                                        <br />

                                        <span class="text-muted">

                                            ₹@((item.Price * item.Quantity)
                                                .ToString("0.00"))

                                        </span>

                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">
                                    No items found.
                                </p>
                            }

                        </div>


                        <!-- TOTAL -->

                        <div class="col-md-2">

                            <h5>
                                💰 Total
                            </h5>

                            <hr />

                            <h4 class="text-success">

                                ₹@order.TotalAmount.ToString("0.00")

                            </h4>

                            @if (order.Payment != null)
                            {
                                <p class="mt-3">

                                    <strong>Payment:</strong><br />

                                    @order.Payment.PaymentMethod

                                    <br />

                                    <span class="badge bg-success mt-1">

                                        @order.Payment.PaymentStatus

                                    </span>

                                </p>
                            }

                        </div>


                        <!-- DELIVERY STATUS -->

                        <div class="col-md-3">

                            <h5>
                                🚚 Delivery Status
                            </h5>

                            <hr />

                            <form asp-controller="Admin"
                                  asp-action="UpdateOrderStatus"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@order.OrderId" />


                                <select name="status"
                                        class="form-select mb-3"
                                        required>

                                    @if (order.Status == "Pending")
                                    {
                                        <option value="Pending" selected>
                                            Pending
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="Pending">
                                            Pending
                                        </option>
                                    }


                                    @if (order.Status == "Preparing")
                                    {
                                        <option value="Preparing" selected>
                                            Preparing
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="Preparing">
                                            Preparing
                                        </option>
                                    }


                                    @if (order.Status == "Ready")
                                    {
                                        <option value="Ready" selected>
                                            Ready
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="Ready">
                                            Ready
                                        </option>
                                    }


                                    @if (order.Status == "Out for Delivery")
                                    {
                                        <option value="Out for Delivery" selected>
                                            Out for Delivery
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="Out for Delivery">
                                            Out for Delivery
                                        </option>
                                    }


                                    @if (order.Status == "Delivered")
                                    {
                                        <option value="Delivered" selected>
                                            Delivered
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="Delivered">
                                            Delivered
                                        </option>
                                    }


                                    @if (order.Status == "Cancelled")
                                    {
                                        <option value="Cancelled" selected>
                                            Cancelled
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="Cancelled">
                                            Cancelled
                                        </option>
                                    }

                                </select>


                                <button type="submit"
                                        class="btn btn-primary w-100">

                                    🔄 Update Status

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>
        }
    }

</div>