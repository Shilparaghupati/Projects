@model List<CanteenWeb.Models.CartSessionItem>

@{
    ViewData["Title"] = "My Cart";
}

<div class="container mt-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>
            <h1>🛒 My Cart</h1>

            <p class="text-muted">
                Review your selected food items
            </p>
        </div>

        <div>

            <a asp-controller="Customer"
               asp-action="Menu"
               class="btn btn-secondary">

                ← Continue Shopping

            </a>

        </div>

    </div>


    <!-- ERROR MESSAGE -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- SUCCESS MESSAGE -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- EMPTY CART -->

    @if (Model == null || Model.Count == 0)
    {
        <div class="card shadow text-center p-5">

            <h2>🛒 Your cart is empty</h2>

            <p class="text-muted">
                You haven't added any food items yet.
            </p>

            <div class="mt-3">

                <a asp-controller="Customer"
                   asp-action="Menu"
                   class="btn btn-primary">

                    🍴 Browse Menu

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row">

            <!-- =====================================
                 CART ITEMS
                 ===================================== -->

            <div class="col-md-8">

                @foreach (var item in Model)
                {
                    <div class="card shadow-sm mb-3">

                        <div class="card-body">

                            <div class="row align-items-center">

                                <!-- IMAGE -->

                                <div class="col-md-2 text-center">

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             style="width:80px;
                                                    height:80px;
                                                    object-fit:cover;
                                                    border-radius:10px;" />
                                    }
                                    else
                                    {
                                        <span style="font-size:50px;">
                                            🍴
                                        </span>
                                    }

                                </div>


                                <!-- FOOD NAME -->

                                <div class="col-md-3">

                                    <h5 class="mb-1">
                                        @item.Name
                                    </h5>

                                    <small class="text-muted">
                                        @item.Category
                                    </small>

                                    <br />

                                    <small>
                                        ₹@item.Price.ToString("0.00")
                                        per item
                                    </small>

                                </div>


                                <!-- QUANTITY -->

                                <div class="col-md-3">

                                    <label class="d-block mb-2">
                                        Quantity
                                    </label>

                                    <div class="d-flex
                                                align-items-center">

                                        <!-- DECREASE -->

                                        <form asp-controller="Customer"
                                              asp-action="DecreaseQuantity"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="foodId"
                                                   value="@item.FoodId" />

                                            <button type="submit"
                                                    class="btn btn-outline-secondary">

                                                −

                                            </button>

                                        </form>


                                        <!-- QUANTITY -->

                                        <span class="mx-3 fw-bold">

                                            @item.Quantity

                                        </span>


                                        <!-- INCREASE -->

                                        <form asp-controller="Customer"
                                              asp-action="IncreaseQuantity"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="foodId"
                                                   value="@item.FoodId" />

                                            <button type="submit"
                                                    class="btn btn-outline-secondary">

                                                +

                                            </button>

                                        </form>

                                    </div>

                                </div>


                                <!-- ITEM TOTAL -->

                                <div class="col-md-2">

                                    <small class="text-muted">
                                        Item Total
                                    </small>

                                    <br />

                                    <strong class="text-success">

                                        ₹@((item.Price *
                                            item.Quantity)
                                            .ToString("0.00"))

                                    </strong>

                                </div>


                                <!-- REMOVE -->

                                <div class="col-md-2">

                                    <form asp-controller="Customer"
                                          asp-action="RemoveFromCart"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="foodId"
                                               value="@item.FoodId" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">

                                            🗑 Remove

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>


            <!-- =====================================
                 ORDER SUMMARY
                 ===================================== -->

            <div class="col-md-4">

                <div class="card shadow">

                    <div class="card-body">

                        <h3>
                            🧾 Order Summary
                        </h3>

                        <hr />


                        <!-- NUMBER OF ITEMS -->

                        <div class="d-flex
                                    justify-content-between
                                    mb-2">

                            <span>
                                Total Items
                            </span>

                            <strong>

                                @Model.Sum(x => x.Quantity)

                            </strong>

                        </div>


                        <!-- TOTAL -->

                        <div class="d-flex
                                    justify-content-between
                                    mb-3">

                            <span>
                                Total Amount
                            </span>

                            <strong class="text-success">

                                ₹@Model.Sum(
                                    x => x.Price * x.Quantity
                                ).ToString("0.00")

                            </strong>

                        </div>


                        <hr />


                        <!-- CHECKOUT -->

                        <a asp-controller="Customer"
                           asp-action="Checkout"
                           class="btn btn-success w-100">

                            💳 Proceed to Payment

                        </a>


                        <!-- CLEAR CART -->

                        <form asp-controller="Customer"
                              asp-action="ClearCart"
                              method="post"
                              class="mt-2">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger w-100"
                                    onclick="return confirm('Are you sure you want to clear the entire cart?');">

                                🗑 Clear Cart

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }
    
    
</div>