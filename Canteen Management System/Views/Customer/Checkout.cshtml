@model List<CanteenWeb.Models.CartSessionItem>

@{
    ViewData["Title"] = "Checkout";

    decimal totalAmount =
        Model.Sum(x => x.Price * x.Quantity);
}

<div class="container mt-5">

    <div class="text-center mb-4">

        <h1>💳 Checkout</h1>

        <p class="text-muted">
            Select your payment method
        </p>

    </div>


    <!-- ERROR -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }


    <div class="row justify-content-center">

        <!-- =====================================
             ORDER SUMMARY
             ===================================== -->

        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-body">

                    <h3>
                        🧾 Order Summary
                    </h3>

                    <hr />

                    @foreach (var item in Model)
                    {
                        <div class="d-flex
                                    justify-content-between
                                    mb-3">

                            <div>

                                <strong>
                                    @item.Name
                                </strong>

                                <br />

                                <small class="text-muted">

                                    @item.Quantity ×
                                    ₹@item.Price.ToString("0.00")

                                </small>

                            </div>

                            <strong>

                                ₹@((item.Price *
                                    item.Quantity)
                                    .ToString("0.00"))

                            </strong>

                        </div>
                    }

                    <hr />

                    <div class="d-flex
                                justify-content-between">

                        <strong>
                            Total Amount
                        </strong>

                        <strong class="text-success fs-4">

                            ₹@totalAmount.ToString("0.00")

                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================
             PAYMENT METHODS
             ===================================== -->

        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-body">

                    <h3>
                        💰 Payment Method
                    </h3>

                    <hr />


                    <!-- ONLINE -->

                    <div class="border rounded p-3 mb-3">

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="radio"
                                   name="paymentChoice"
                                   id="onlinePayment"
                                   value="Online" />

                            <label class="form-check-label"
                                   for="onlinePayment">

                                📱 Online Payment

                            </label>

                        </div>

                    </div>


                    <!-- CASH -->

                    <div class="border rounded p-3 mb-3">

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="radio"
                                   name="paymentChoice"
                                   id="cashPayment"
                                   value="Cash" />

                            <label class="form-check-label"
                                   for="cashPayment">

                                💵 Cash Payment

                            </label>

                        </div>

                    </div>


                    <!-- =================================
                         ONLINE PAYMENT
                         ================================= -->

                    <div id="onlineSection"
                         style="display:none;"
                         class="text-center">

                        <hr />

                        <h4>
                            📱 Scan QR Code
                        </h4>

                        <p>
                            Pay exactly
                        </p>

                        <h2 class="text-success">

                            ₹@totalAmount.ToString("0.00")

                        </h2>


                        <!-- QR PLACEHOLDER -->

                        <div class="border rounded p-4
                                    bg-light mb-3">

                            <div style="font-size:120px;">

                                ▦

                            </div>

                            <p class="mb-0">

                                Canteen Payment QR

                            </p>

                        </div>


                        <p class="text-muted">

                            Scan the QR code using
                            your UPI application.

                        </p>


                        <form asp-controller="Customer"
                              asp-action="ProcessPayment"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="paymentMethod"
                                   value="Online" />

                            <button type="submit"
                                    class="btn btn-success w-100">

                                ✅ I Have Completed Payment

                            </button>

                        </form>

                    </div>


                    <!-- =================================
                         CASH PAYMENT
                         ================================= -->

                    <div id="cashSection"
                         style="display:none;"
                         class="mt-3">

                        <hr />

                        <div class="alert alert-warning">

                            <h5>
                                💵 Cash Payment
                            </h5>

                            <p class="mb-0">

                                Please pay

                                <strong>
                                    ₹@totalAmount.ToString("0.00")
                                </strong>

                                at the canteen counter.

                            </p>

                        </div>


                        <form asp-controller="Customer"
                              asp-action="ProcessPayment"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="paymentMethod"
                                   value="Cash" />

                            <button type="submit"
                                    class="btn btn-primary w-100">

                                💵 Confirm Cash Payment

                            </button>

                        </form>

                    </div>


                    <!-- BACK -->

                    <a asp-controller="Customer"
                       asp-action="Cart"
                       class="btn btn-secondary w-100 mt-3">

                        ← Back to Cart

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    const onlinePayment =
        document.getElementById("onlinePayment");

    const cashPayment =
        document.getElementById("cashPayment");

    const onlineSection =
        document.getElementById("onlineSection");

    const cashSection =
        document.getElementById("cashSection");


    onlinePayment.addEventListener(
        "change",
        function ()
        {
            onlineSection.style.display = "block";

            cashSection.style.display = "none";
        });


    cashPayment.addEventListener(
        "change",
        function ()
        {
            cashSection.style.display = "block";

            onlineSection.style.display = "none";
        });

</script>