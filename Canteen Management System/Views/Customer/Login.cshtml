@{
    ViewData["Title"] = "Customer Login";
}

<style>

    /* =========================================
       PAGE RESET
       ========================================= */

    .customer-login-page,
    .customer-login-page * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
    }

    body {
        overflow-x: hidden;
        font-family: Arial, sans-serif;
    }


    /* =========================================
       FULL PAGE BACKGROUND
       ========================================= */

    .customer-login-page {

        width: 100vw;

        min-height: calc(100vh - 60px);

        /* Escape Bootstrap container */
        margin-left: calc(50% - 50vw);

        display: flex;

        justify-content: center;

        align-items: center;

        padding: 50px 20px;

        position: relative;

        background-image:
            linear-gradient(
                rgba(0, 0, 0, 0.55),
                rgba(0, 0, 0, 0.55)
            ),
            url("/images/customer-login.jpg");

        background-size: cover;

        background-position: center;

        background-repeat: no-repeat;

        background-attachment: fixed;
    }


    /* =========================================
       LOGIN CARD
       ========================================= */

    .customer-login-card {

        width: 420px;

        max-width: 100%;

        padding: 40px;

        background: rgba(255, 255, 255, 0.97);

        border-radius: 20px;

        box-shadow:
            0 18px 50px rgba(0, 0, 0, 0.40);

        backdrop-filter: blur(6px);
    }


    /* =========================================
       ICON
       ========================================= */

    .customer-login-icon {

        width: 65px;

        height: 65px;

        margin: 0 auto 15px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 50%;

        background: #fff1df;

        font-size: 32px;
    }


    /* =========================================
       TITLE
       ========================================= */

    .customer-login-title {

        margin: 0;

        text-align: center;

        color: #333;

        font-size: 32px;

        font-weight: 500;
    }


    .customer-login-subtitle {

        margin: 10px 0 30px;

        text-align: center;

        color: #777;

        font-size: 15px;

        line-height: 1.5;
    }


    /* =========================================
       FORM GROUP
       ========================================= */

    .customer-form-group {

        margin-bottom: 20px;
    }


    .customer-form-group label {

        display: block;

        margin-bottom: 8px;

        color: #333;

        font-size: 15px;

        font-weight: bold;
    }


    /* =========================================
       INPUT
       ========================================= */

    .customer-form-group input {

        width: 100%;

        height: 50px;

        padding: 12px 15px;

        border: 1px solid #ccc;

        border-radius: 9px;

        background: #fff;

        color: #333;

        font-size: 15px;

        outline: none;

        transition: all 0.25s ease;
    }


    .customer-form-group input::placeholder {

        color: #999;
    }


    .customer-form-group input:focus {

        border-color: #ff7200;

        box-shadow:
            0 0 0 3px rgba(255, 114, 0, 0.15);
    }


    /* =========================================
       PASSWORD WRAPPER
       ========================================= */

    .customer-password-wrapper {

        position: relative;

        width: 100%;
    }


    .customer-password-wrapper input {

        padding-right: 55px;
    }


    /* =========================================
       PASSWORD EYE BUTTON
       ========================================= */

    .customer-password-eye {

        position: absolute;

        right: 8px;

        top: 50%;

        transform: translateY(-50%);

        width: 40px;

        height: 40px;

        display: flex;

        align-items: center;

        justify-content: center;

        border: none;

        outline: none;

        background: transparent;

        cursor: pointer;

        font-size: 20px;

        border-radius: 50%;

        z-index: 10;
    }


    .customer-password-eye:hover {

        background: #fff1df;
    }


    /* Hide browser's built-in password eye */

    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {

        display: none;
    }


    /* =========================================
       LOGIN BUTTON
       ========================================= */

    .customer-login-button {

        width: 100%;

        height: 52px;

        margin-top: 5px;

        border: none;

        border-radius: 9px;

        background:
            linear-gradient(
                135deg,
                #ff7a00,
                #ff4d00
            );

        color: white;

        font-size: 17px;

        font-weight: bold;

        cursor: pointer;

        transition: all 0.25s ease;
    }


    .customer-login-button:hover {

        transform: translateY(-2px);

        box-shadow:
            0 8px 20px rgba(255, 102, 0, 0.35);
    }


    .customer-login-button:active {

        transform: translateY(0);
    }


    /* =========================================
       ERROR MESSAGE
       ========================================= */

    .customer-login-error {

        margin-bottom: 18px;

        padding: 10px;

        border-radius: 7px;

        background: #ffe5e5;

        color: #dc3545;

        text-align: center;

        font-size: 14px;
    }


    /* =========================================
       SUCCESS MESSAGE
       ========================================= */

    .customer-login-success {

        margin-bottom: 18px;

        padding: 10px;

        border-radius: 7px;

        background: #e3f7eb;

        color: #198754;

        text-align: center;

        font-size: 14px;
    }


    /* =========================================
       SIGN UP
       ========================================= */

    .customer-signup-link {

        margin-top: 25px;

        color: #666;

        text-align: center;

        font-size: 15px;
    }


    .customer-signup-link a {

        color: #ff6500;

        text-decoration: none;

        font-weight: bold;
    }


    .customer-signup-link a:hover {

        text-decoration: underline;
    }


    /* =========================================
       BACK HOME
       ========================================= */

    .customer-back-home {

        margin-top: 15px;

        text-align: center;
    }


    .customer-back-home a {

        color: #555;

        text-decoration: none;

        font-size: 14px;
    }


    .customer-back-home a:hover {

        color: #ff6500;
    }


    /* =========================================
       MOBILE
       ========================================= */

    @@media (max-width: 600px) {

        .customer-login-page {

            min-height: calc(100vh - 60px);

            padding: 30px 15px;

            background-attachment: scroll;
        }


        .customer-login-card {

            padding: 30px 25px;

            border-radius: 16px;
        }


        .customer-login-title {

            font-size: 28px;
        }


        .customer-login-subtitle {

            font-size: 14px;

            margin-bottom: 25px;
        }

    }

</style>


<!-- =========================================
     CUSTOMER LOGIN PAGE
     ========================================= -->

<div class="customer-login-page">


    <!-- LOGIN CARD -->

    <div class="customer-login-card">


        <!-- ICON -->

        <div class="customer-login-icon">

            🍽️

        </div>


        <!-- TITLE -->

        <h1 class="customer-login-title">

            Customer Login

        </h1>


        <p class="customer-login-subtitle">

            Welcome back! Login to order your favourite food.

        </p>


        <!-- ERROR -->

        @if (ViewBag.Error != null)
        {
            <div class="customer-login-error">

                @ViewBag.Error

            </div>
        }


        <!-- SUCCESS -->

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="customer-login-success">

                @TempData["SuccessMessage"]

            </div>
        }


        <!-- LOGIN FORM -->

        <form asp-controller="Customer"
              asp-action="Login"
              method="post">


            <!-- EMAIL -->

            <div class="customer-form-group">

                <label for="customer-email">

                    Email

                </label>


                <input type="email"
                       id="customer-email"
                       name="email"
                       placeholder="Enter your Gmail"
                       autocomplete="email"
                       required />

            </div>


            <!-- PASSWORD -->

            <div class="customer-form-group">

                <label for="customer-password">

                    Password

                </label>


                <div class="customer-password-wrapper">


                    <input type="password"
                           id="customer-password"
                           name="password"
                           placeholder="Enter your password"
                           autocomplete="current-password"
                           required />


                    <button type="button"
                            class="customer-password-eye"
                            onclick="toggleCustomerPassword()"
                            aria-label="Show or hide password">

                        👁️

                    </button>


                </div>

            </div>


            <!-- LOGIN BUTTON -->

            <button type="submit"
                    class="customer-login-button">

                Login 🍴

            </button>


        </form>


        <!-- SIGN UP -->

        <div class="customer-signup-link">

            Don't have an account?

            <a href="/Customer/Register">

                Sign Up

            </a>

        </div>


        <!-- BACK HOME -->

        <div class="customer-back-home">

            <a href="/Home/Index">

                ← Back to Home

            </a>

        </div>


    </div>

</div>


<!-- =========================================
     PASSWORD SHOW / HIDE
     ========================================= -->

<script>

    function toggleCustomerPassword() {

        const password =
            document.getElementById("customer-password");

        const eye =
            document.querySelector(".customer-password-eye");


        if (password.type === "password") {

            password.type = "text";

            eye.textContent = "🙈";

        }
        else {

            password.type = "password";

            eye.textContent = "👁️";

        }

    }

</script>