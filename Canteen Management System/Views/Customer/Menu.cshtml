@model List<CanteenWeb.Models.FoodItem>

@{
    ViewData["Title"] = "Food Menu";
}

<div class="container mt-4">

    <!-- =========================================
         HEADER
         ========================================= -->

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <h1>🍴 Canteen Food Menu</h1>

            <p class="text-muted mb-0">
                Choose your favourite food
            </p>

        </div>

        <!-- VIEW CART -->

        <a asp-controller="Customer"
           asp-action="Cart"
           class="btn btn-success">

            🛒 View Cart

        </a>

    </div>


    <!-- =========================================
         SUCCESS MESSAGE
         ========================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            @TempData["Success"]

        </div>
    }


    <!-- =========================================
         ERROR MESSAGE
         ========================================= -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }


    <!-- =========================================
         SEARCH
         ========================================= -->

    <div class="row justify-content-center mb-5">

        <div class="col-md-8">

            <form asp-controller="Customer"
                  asp-action="Menu"
                  method="get">

                <div class="input-group">

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search food name or category..." />

                    <button type="submit"
                            class="btn btn-primary">

                        🔍 Search

                    </button>


                    <a asp-controller="Customer"
                       asp-action="Menu"
                       class="btn btn-secondary">

                        Clear

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================================
         FOOD ITEMS
         ========================================= -->

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning text-center">

            <h5>No food items found.</h5>

            <p class="mb-0">

                Try another food name or category.

            </p>

        </div>
    }
    else
    {
        <div class="row">

            @foreach (var food in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow h-100">


                        <!-- =================================
                             FOOD IMAGE
                             ================================= -->

                        @if (!string.IsNullOrWhiteSpace(
                            food.ImageUrl))
                        {
                            <img src="@food.ImageUrl"
                                 class="card-img-top"
                                 alt="@food.Name"
                                 style="height:220px;
                                        object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-light
                                        text-center
                                        d-flex
                                        align-items-center
                                        justify-content-center"
                                 style="height:220px;">

                                <span style="font-size:60px;">
                                    🍴
                                </span>

                            </div>
                        }


                        <!-- =================================
                             FOOD DETAILS
                             ================================= -->

                        <div class="card-body">

                            <h4 class="card-title">

                                @food.Name

                            </h4>


                            <span class="badge bg-secondary">

                                @food.Category

                            </span>


                            <p class="card-text mt-3">

                                @food.Description

                            </p>


                            <h5 class="text-success">

                                ₹@food.Price.ToString("0.00")

                            </h5>


                            <!-- =================================
                                 ADD TO CART
                                 ================================= -->

                            <form asp-controller="Customer"
                                  asp-action="AddToCart"
                                  method="post"
                                  class="mt-3">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="foodId"
                                       value="@food.FoodId" />

                                <button type="submit"
                                        class="btn btn-primary w-100">

                                    🛒 Add to Cart

                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }


    <!-- =========================================
         BOTTOM BUTTONS
         ========================================= -->

    <div class="text-center mt-4 mb-5">

        <a asp-controller="Customer"
           asp-action="Customer"
           class="btn btn-secondary">

            ← Back

        </a>

        <div class="d-flex justify-content-end gap-2 mb-4">

    <a asp-controller="Customer"
       asp-action="Cart"
       class="btn btn-success">

        🛒 Cart

    </a>

    <a asp-controller="Customer"
       asp-action="OrderHistory"
       class="btn btn-info">

        📋 Order History

    </a>

</div>


        <a asp-controller="Customer"
           asp-action="Logout"
           class="btn btn-danger">

            Logout

        </a>

    </div>

</div>