@model List<CanteenWeb.Models.Order>

@{
    ViewData["Title"] = "My Order History";
}

<div class="container mt-4 mb-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>📋 My Order History</h1>
            <p class="text-muted">
                View your previous orders and delivery status.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Customer"
               asp-action="Menu"
               class="btn btn-primary">
                🍴 Menu
            </a>

            <a asp-controller="Customer"
               asp-action="Cart"
               class="btn btn-success">
                🛒 Cart
            </a>

        </div>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- NO ORDERS -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="card shadow-sm">

            <div class="card-body text-center p-5">

                <div style="font-size: 60px;">
                    📦
                </div>

                <h3 class="mt-3">
                    No Orders Yet
                </h3>

                <p class="text-muted">
                    You haven't placed any orders yet.
                </p>

                <a asp-controller="Customer"
                   asp-action="Menu"
                   class="btn btn-primary">
                    🍴 Browse Menu
                </a>

            </div>

        </div>
    }
    else
    {
        <!-- ORDERS -->

        @foreach (var order in Model)
        {
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <!-- ORDER HEADER -->
                    <div class="row align-items-center">

                        <div class="col-md-7">

                            <h4>
                                🧾 Order #@order.OrderId
                            </h4>

                            <p class="text-muted mb-0">

                                <strong>
                                    Order Date:
                                </strong>

                                @order.OrderDate
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt")

                            </p>

                        </div>


                        <!-- TOTAL + STATUS -->
                        <div class="col-md-5 text-md-end">

                            <h4 class="text-success">
                                ₹@order.TotalAmount.ToString("0.00")
                            </h4>


                            @switch (order.Status)
                            {
                                case "Pending":

                                    <span class="badge bg-warning text-dark p-2">
                                        🕐 Pending
                                    </span>

                                    break;


                                case "Preparing":

                                    <span class="badge bg-info p-2">
                                        👨‍🍳 Preparing
                                    </span>

                                    break;


                                case "Ready":

                                    <span class="badge bg-primary p-2">
                                        ✅ Ready
                                    </span>

                                    break;


                                case "Out for Delivery":

                                    <span class="badge bg-primary p-2">
                                        🛵 Out for Delivery
                                    </span>

                                    break;


                                case "Delivered":

                                    <span class="badge bg-success p-2">
                                        🎉 Delivered
                                    </span>

                                    break;


                                case "Cancelled":

                                    <span class="badge bg-danger p-2">
                                        ❌ Cancelled
                                    </span>

                                    break;


                                default:

                                    <span class="badge bg-secondary p-2">
                                        @order.Status
                                    </span>

                                    break;
                            }

                        </div>

                    </div>


                    <hr />


                    <!-- ORDER ITEMS -->
                    <h5 class="mb-3">
                        🍴 Ordered Items
                    </h5>

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover">

                            <thead class="table-light">

                                <tr>
                                    <th>Food</th>
                                    <th>Category</th>
                                    <th>Quantity</th>
                                    <th>Price</th>
                                    <th>Total</th>
                                </tr>

                            </thead>


                            <tbody>

                                @if (order.OrderItems != null &&
                                     order.OrderItems.Any())
                                {
                                    foreach (var item in order.OrderItems)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @(item.FoodItem?.Name
                                                        ?? "Food Item")
                                                </strong>
                                            </td>

                                            <td>
                                                @(item.FoodItem?.Category
                                                    ?? "-")
                                            </td>

                                            <td>
                                                @item.Quantity
                                            </td>

                                            <td>
                                                ₹@item.Price.ToString("0.00")
                                            </td>

                                            <td>
                                                ₹@((item.Price *
                                                    item.Quantity)
                                                    .ToString("0.00"))
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="5"
                                            class="text-center text-muted">

                                            No order items found.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- PAYMENT -->
                    @if (order.Payment != null)
                    {
                        <div class="card bg-light mt-3">

                            <div class="card-body">

                                <h5>
                                    💳 Payment Information
                                </h5>

                                <div class="row">

                                    <div class="col-md-6">

                                        <strong>
                                            Payment Method:
                                        </strong>

                                        @order.Payment.PaymentMethod

                                    </div>


                                    <div class="col-md-6">

                                        <strong>
                                            Payment Status:
                                        </strong>

                                        @if (order.Payment.PaymentStatus == "Paid")
                                        {
                                            <span class="text-success">
                                                ✅ Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @order.Payment.PaymentStatus
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>
                    }


                    <!-- DELIVERY TRACKING -->
                    <div class="mt-4">

                        <h5>
                            🚚 Delivery Tracking
                        </h5>


                        @if (order.Status == "Cancelled")
                        {
                            <div class="progress"
                                 style="height: 25px;">

                                <div class="progress-bar bg-danger"
                                     style="width: 100%;">

                                    ❌ Order Cancelled

                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="progress"
                                 style="height: 25px;">

                                @switch (order.Status)
                                {
                                    case "Pending":

                                        <div class="progress-bar bg-warning text-dark"
                                             style="width:20%;">

                                            Pending

                                        </div>

                                        break;


                                    case "Preparing":

                                        <div class="progress-bar bg-info"
                                             style="width:40%;">

                                            Preparing

                                        </div>

                                        break;


                                    case "Ready":

                                        <div class="progress-bar bg-primary"
                                             style="width:60%;">

                                            Ready

                                        </div>

                                        break;


                                    case "Out for Delivery":

                                        <div class="progress-bar bg-primary"
                                             style="width:80%;">

                                            Out for Delivery

                                        </div>

                                        break;


                                    case "Delivered":

                                        <div class="progress-bar bg-success"
                                             style="width:100%;">

                                            Delivered 🎉

                                        </div>

                                        break;


                                    default:

                                        <div class="progress-bar bg-secondary"
                                             style="width:20%;">

                                            @order.Status

                                        </div>

                                        break;
                                }

                            </div>
                        }

                    </div>

                </div>

            </div>
        }
    }


    <!-- BOTTOM BUTTONS -->

    <div class="text-center mt-4">

        <a asp-controller="Customer"
           asp-action="Menu"
           class="btn btn-primary">

            🍴 Continue Shopping

        </a>

        <a asp-controller="Customer"
           asp-action="Logout"
           class="btn btn-danger">

            Logout

        </a>

    </div>

</div>