@model CanteenWeb.Models.Order

@{
    ViewData["Title"] = "Order Successful";
}

<div class="container mt-5">

    <div class="card shadow text-center">

        <div class="card-body p-5">

            <!-- SUCCESS ICON -->

            <div style="font-size:80px;">
                ✅
            </div>


            <!-- THANK YOU -->

            <h1 class="text-success mt-3">
                Thank You for Your Order!
            </h1>

            <h4 class="mt-3">
                Your order has been placed successfully.
            </h4>

            <p class="text-muted">
                We have received your order and payment.
            </p>


            <hr />


            <!-- ORDER NUMBER -->

            <h4>
                Order #@Model.OrderId
            </h4>


            <!-- ORDER DATE -->

            <p>
                Order Date:
                @Model.OrderDate.ToLocalTime()
            </p>


            <!-- TOTAL -->

            <p>

                Total Amount:

                <strong class="text-success">

                    ₹@Model.TotalAmount.ToString("0.00")

                </strong>

            </p>


            <!-- PAYMENT -->

            @if (Model.Payment != null)
            {
                <div class="alert alert-success mt-4">

                    <strong>
                        Payment Successful
                    </strong>

                    <br />

                    Payment Method:
                    @Model.Payment.PaymentMethod

                    <br />

                    Payment Status:
                    @Model.Payment.PaymentStatus

                </div>
            }


            <!-- REDIRECT MESSAGE -->

            <div class="alert alert-info mt-4">

                <strong>
                    Returning to Menu...
                </strong>

                <br />

                <span id="countdown">
                    3
                </span>

                seconds remaining

            </div>


            <!-- MANUAL BUTTON -->

            <a asp-controller="Customer"
               asp-action="Menu"
               class="btn btn-primary mt-3">

                🍴 Go to Menu

            </a>

        </div>

    </div>

</div>


<script>

    let seconds = 3;

    const countdown =
        document.getElementById("countdown");


    const timer = setInterval(function () {

        seconds--;

        countdown.textContent = seconds;


        if (seconds <= 0) {

            clearInterval(timer);

            // Redirect to Customer Menu
            window.location.href =
                '@Url.Action("Menu", "Customer")';

        }

    }, 1000);

</script>