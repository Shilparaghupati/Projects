@{
    ViewData["Title"] = "Customer";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Customer</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fb;
        }

        .container {
            width: 400px;
            margin: 100px auto;
            background: white;
            padding: 40px;
            text-align: center;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        }

        h1 {
            color: #333;
            margin-bottom: 10px;
        }

        p {
            color: #777;
            margin-bottom: 30px;
        }

        .btn {
            display: block;
            width: 100%;
            padding: 15px;
            margin: 15px 0;
            border-radius: 8px;
            text-decoration: none;
            color: white;
            font-size: 18px;
            font-weight: bold;
            box-sizing: border-box;
        }

        .login {
            background: #007bff;
        }

        .signup {
            background: #28a745;
        }

        .btn:hover {
            opacity: 0.85;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Customer</h1>

        <p>Please choose an option</p>

        <a href="/Customer/Login" class="btn login">
            Login
        </a>

        <a href="/Customer/Register" class="btn signup">
            Sign Up
        </a>

    </div>

</body>
</html>