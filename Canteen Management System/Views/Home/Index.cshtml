@{
    ViewData["Title"] = "Welcome - Canteen Management System";
}

<style>

    * {
        box-sizing: border-box;
    }

    html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
}

body {
    overflow-x: hidden;
}


    /* =========================================
       FULL HOME PAGE
       ========================================= */

    .hotel-home {

    /* FULL BROWSER WIDTH */
    width: 100vw;

    /* Escape the Bootstrap container */
    margin-left: calc(50% - 50vw);

    min-height: calc(100vh - 60px);

    position: relative;

    display: flex;

    align-items: center;

    overflow: hidden;

    background:
        linear-gradient(
            rgba(0, 0, 0, 0.58),
            rgba(0, 0, 0, 0.58)
        ),
        url("/images/canteen-bg.jpg");

    background-size: cover;

    background-position: center;

    background-repeat: no-repeat;

    background-attachment: fixed;
}

    /* =========================================
       CONTENT
       ========================================= */

    .hotel-content {

        width: 1150px;

        max-width: 92%;

        margin: auto;

        display: grid;

        grid-template-columns: 1.3fr 0.8fr;

        gap: 80px;

        align-items: center;
    }


    /* =========================================
       LEFT SIDE
       ========================================= */

    .hotel-welcome {

        color: white;

        padding: 30px;
    }


    .hotel-welcome .small-title {

        font-size: 18px;

        letter-spacing: 3px;

        text-transform: uppercase;

        color: #ffd39b;

        margin-bottom: 15px;

        font-weight: 600;
    }


    .hotel-welcome h1 {

        font-size: 58px;

        line-height: 1.1;

        margin: 0 0 20px;

        font-weight: 800;

        text-shadow:
            0 3px 10px rgba(0,0,0,0.4);
    }


    .hotel-welcome h1 span {

        color: #ffad5c;
    }


    .hotel-caption {

        font-size: 20px;

        line-height: 1.7;

        max-width: 600px;

        color: #f4f4f4;

        margin-bottom: 25px;
    }


    .hotel-quote {

        font-size: 17px;

        font-style: italic;

        color: #ffd9b0;

        border-left: 4px solid #e67e22;

        padding-left: 15px;
    }


    /* =========================================
       LOGIN CARD
       ========================================= */

    .login-selection-card {

        background: rgba(255,255,255,0.97);

        padding: 35px;

        border-radius: 22px;

        box-shadow:
            0 20px 50px rgba(0,0,0,0.35);

        text-align: center;
    }


    .login-selection-card h2 {

        margin: 0;

        color: #3d2b1f;

        font-size: 30px;
    }


    .login-selection-card .subtitle {

        color: #777;

        margin: 10px 0 28px;
    }


    /* =========================================
       CUSTOMER SECTION
       ========================================= */

    .customer-section {

        background: #f7faf7;

        padding: 20px;

        border-radius: 15px;

        margin-bottom: 20px;
    }


    .customer-icon {

        font-size: 42px;

        margin-bottom: 5px;
    }


    .customer-section h3 {

        margin: 5px 0;

        color: #333;
    }


    .customer-section p {

        color: #777;

        font-size: 14px;

        margin-bottom: 18px;
    }


    .customer-buttons {

        display: flex;

        gap: 10px;
    }


    .customer-login {

        flex: 1;

        background: #2e8b57;

        color: white;

        padding: 12px;

        border-radius: 8px;

        text-decoration: none;

        font-weight: 700;
    }


    .customer-signup {

        flex: 1;

        background: white;

        color: #2e8b57;

        border: 2px solid #2e8b57;

        padding: 10px;

        border-radius: 8px;

        text-decoration: none;

        font-weight: 700;
    }


    .customer-login:hover {

        background: #267349;

        color: white;

        text-decoration: none;
    }


    .customer-signup:hover {

        background: #2e8b57;

        color: white;

        text-decoration: none;
    }


    /* =========================================
       DIVIDER
       ========================================= */

    .login-divider {

        display: flex;

        align-items: center;

        gap: 10px;

        color: #aaa;

        font-size: 13px;

        margin: 20px 0;
    }


    .login-divider::before,
    .login-divider::after {

        content: "";

        height: 1px;

        background: #ddd;

        flex: 1;
    }


    /* =========================================
       ADMIN
       ========================================= */

    .admin-login {

        display: block;

        width: 100%;

        padding: 14px;

        background: #e67e22;

        color: white;

        border-radius: 9px;

        text-decoration: none;

        font-weight: 700;

        font-size: 16px;
    }


    .admin-login:hover {

        background: #cf6815;

        color: white;

        text-decoration: none;

        transform: translateY(-1px);
    }


    /* =========================================
       FOOTER
       ========================================= */

    .home-footer {

        margin-top: 22px;

        font-size: 12px;

        color: #999;
    }


    /* =========================================
       TABLET
       ========================================= */

    @@media (max-width: 900px) {

        .hotel-content {

            grid-template-columns: 1fr;

            gap: 20px;

            padding: 50px 0;
        }


        .hotel-welcome {

            text-align: center;

            padding: 10px;
        }


        .hotel-welcome h1 {

            font-size: 45px;
        }


        .hotel-caption {

            margin-left: auto;

            margin-right: auto;
        }


        .hotel-quote {

            border-left: none;

            padding-left: 0;
        }


        .login-selection-card {

            max-width: 450px;

            width: 100%;

            margin: auto;
        }
    }


    /* =========================================
       MOBILE
       ========================================= */

    @@media (max-width: 500px) {

        .hotel-welcome h1 {

            font-size: 36px;
        }


        .hotel-welcome .small-title {

            font-size: 14px;

            letter-spacing: 2px;
        }


        .hotel-caption {

            font-size: 16px;
        }


        .login-selection-card {

            padding: 25px 20px;
        }


        .customer-buttons {

            flex-direction: column;
        }
    }

</style>


<!-- =========================================
     HOME PAGE
     ========================================= -->

<div class="hotel-home">

    <div class="hotel-content">


        <!-- =================================
             LEFT - WELCOME
             ================================= -->

        <div class="hotel-welcome">

            <div class="small-title">

                🍽️ Welcome to

            </div>


            <h1>

                Our
                <span>Canteen</span>

            </h1>


            <p class="hotel-caption">

                Delicious food, freshly prepared
                and served with love.

                <br />

                Enjoy your favorite meals,
                order easily and experience
                a better way to dine.

            </p>


            <div class="hotel-quote">

                "Good food, good mood,
                good memories."

            </div>

        </div>


        <!-- =================================
             RIGHT - LOGIN
             ================================= -->

        <div class="login-selection-card">

            <h2>
                Welcome! 👋
            </h2>


            <p class="subtitle">

                How would you like to continue?

            </p>


            <!-- CUSTOMER -->

            <div class="customer-section">

                <div class="customer-icon">
                    👤
                </div>


                <h3>
                    Customer
                </h3>


                <p>
                    Order delicious food
                    from our canteen.
                </p>


                <div class="customer-buttons">

                    <a href="/Customer/Login"
                       class="customer-login">

                        Login

                    </a>


                    <a href="/Customer/Register"
                       class="customer-signup">

                        Sign Up

                    </a>

                </div>

            </div>


            <!-- DIVIDER -->

            <div class="login-divider">

                OR

            </div>


            <!-- ADMIN -->

            <a href="/Admin/Login"
               class="admin-login">

                🔐 Admin Login

            </a>


            <div class="home-footer">

                🍴 Canteen Management System

            </div>

        </div>

    </div>

</div>